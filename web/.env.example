# ローカル開発用（本番は Firebase Hosting の /__/firebase/init.json から自動で読み込む）
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=giburu-178f1.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=giburu-178f1
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# 通知の鍵（Firebaseコンソール > プロジェクトの設定 > Cloud Messaging > ウェブプッシュ証明書）。空なら既定の鍵を使う
VITE_FIREBASE_VAPID_KEY=
